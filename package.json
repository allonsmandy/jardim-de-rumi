{
  "name": "jardim-de-rumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jardim de Rumi — Rumi em persa e em português, com explicações para quem nunca leu poesia persa.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx scripts/validate/validate-content.ts",
    "content:next": "tsx scripts/content/next.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm content:validate",
    "import:ganjoor": "tsx scripts/import/ganjoor.ts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@lucide/vue": "^1.70.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/sitemap": "^9.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
